# CodePop OrbitDB Backend Environment Variables

# Node Configuration
NODE_ENV=development
PORT=3001

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret_optional

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@codepop.app

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/codepop_database

# Logging
LOG_LEVEL=info

# API Configuration
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:19000

# Session Configuration
TOKEN_EXPIRATION_HOURS=24

# Feature Flags
ENABLE_MIGRATIONS=false
SEED_TEST_DATA=false
