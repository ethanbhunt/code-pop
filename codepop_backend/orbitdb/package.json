{
  "name": "codepop-orbitdb-backend",
  "version": "1.0.0-beta",
  "type": "module",
  "description": "CodePop decentralized backend using OrbitDB and libp2p",
  "main": "peer-node.js",
  "scripts": {
    "bootstrap": "node bootstrap-node.js",
    "peer": "PORT=3001 node peer-node.js",
    "peer:3002": "PORT=3002 node peer-node.js",
    "peer:3003": "PORT=3003 node peer-node.js",
    "seed": "python3 scripts/seed_data.py --all",
    "seed:users": "python3 scripts/seed_data.py --users",
    "seed:drinks": "python3 scripts/seed_data.py --drinks",
    "seed:preferences": "python3 scripts/seed_data.py --preferences",
    "seed:inventory": "python3 scripts/seed_data.py --inventory",
    "seed:clear": "python3 scripts/seed_data.py --clear",
    "seed:reset": "python3 scripts/seed_data.py --reset",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest tests/integration --coverage",
    "migrate": "node scripts/migrate-from-django.js",
    "dev": "node peer-node.js"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^13.0.0",
    "@chainsafe/libp2p-noise": "^15.1.0",
    "@chainsafe/libp2p-yamux": "^6.0.2",
    "@libp2p/identify": "^2.1.5",
    "@libp2p/tcp": "^9.1.0",
    "@multiformats/multiaddr": "^12.3.1",
    "@orbitdb/core": "^2.3.0",
    "bcrypt": "^5.1.1",
    "blockstore-level": "^1.1.8",
    "datastore-level": "^10.1.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.0",
    "helia": "^4.2.6",
    "joi": "^17.13.0",
    "libp2p": "^1.9.4",
    "nodemailer": "^6.9.0",
    "stripe": "^14.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
