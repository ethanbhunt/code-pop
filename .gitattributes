* text=auto

# Force LF for code and docs to reduce cross-platform merge noise.
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Keep Windows scripts with CRLF when needed.
*.bat text eol=crlf
*.ps1 text eol=crlf
